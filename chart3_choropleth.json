{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Aircraft share within company countries with at least 10 matched entries.",
  "width": "container",
  "height": 285,
  "autosize": {"type": "fit", "contains": "padding"},
  "config": {
    "background": "transparent",
    "font": "IBM Plex Sans",
    "view": {"stroke": null},
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#61716a",
      "titleColor": "#20372f",
      "domain": false,
      "tickColor": "#e6ebe6",
      "gridColor": "#e6ebe6",
      "labelPadding": 8,
      "titlePadding": 12
    },
    "legend": {"orient": "bottom", "labelFontSize": 12, "titleFontSize": 12, "titleFontWeight": 500, "labelColor": "#20372f", "titleColor": "#20372f", "padding": 10}
  },
  "data": {"url": "world-map.json", "format": {"type": "topojson", "feature": "countries"}},
  "projection": {"type": "equalEarth"},
  "transform": [
    {"filter": "datum.id != 10"},
    {"lookup": "id", "from": {"data": {"url": "data_countries.json"}, "key": "id", "fields": ["country", "entries", "aircraft_entries", "aircraft_share"]}}
  ],
  "layer": [
    {"mark": {"type": "geoshape", "fill": "#e5eae3", "stroke": "white", "strokeWidth": 0.6}},
    {
      "transform": [{"filter": "isValid(datum.entries) && datum.entries >= 10"}],
      "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 0.6},
      "encoding": {
        "color": {
          "field": "aircraft_share",
          "type": "quantitative",
          "scale": {"domain": [0, 1], "range": ["#f4e6bb", "#155a40"]},
          "legend": {"title": "Aircraft share within country", "format": ".0%", "gradientLength": 220, "values": [0, 0.5, 1]}
        },
        "tooltip": [
          {"field": "country", "type": "nominal", "title": "Company country"},
          {"field": "aircraft_entries", "type": "quantitative", "title": "Aircraft entries"},
          {"field": "entries", "type": "quantitative", "title": "Matched entries"},
          {"field": "aircraft_share", "type": "quantitative", "title": "Aircraft share", "format": ".1%"}
        ]
      }
    }
  ]
}
