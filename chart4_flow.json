{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Schematic company-country connections to the Canberra exhibition, not shipment data.",
  "width": "container",
  "height": 360,
  "autosize": {"type": "fit", "contains": "padding"},
  "projection": {"type": "equalEarth"},
  "layer": [
    {
      "data": {"url": "world-map.json", "format": {"type": "topojson", "feature": "countries"}},
      "transform": [{"filter": "datum.id != 10"}],
      "mark": {"type": "geoshape", "fill": "#e1e7df", "stroke": "white"}
    },
    {
      "data": {"url": "data_countries.json"},
      "mark": {"type": "rule", "color": "#23684f", "opacity": 0.6},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "longitude2": {"datum": 149.13},
        "latitude2": {"datum": -35.28},
        "strokeWidth": {
          "field": "entries", "type": "quantitative",
          "scale": {"domain": [0, 180], "range": [0, 8]},
          "legend": {"title": "Matched entries", "values": [15, 50, 150]}
        },
        "tooltip": [
          {"field": "country", "title": "Company country"},
          {"field": "entries", "type": "quantitative", "title": "Entries exhibited in Canberra"}
        ]
      }
    },
    {
      "data": {"values": [{"lon": 149.13, "lat": -35.28, "place": "Canberra"}]},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"}
      },
      "layer": [
        {"mark": {"type": "point", "shape": "diamond", "filled": true, "size": 120, "color": "#bf5b30"}},
        {
          "mark": {"type": "text", "dy": 20, "fontSize": 13, "fontWeight": "bold"},
          "encoding": {"text": {"field": "place"}}
        }
      ]
    }
  ],
  "config": {
    "view": {"stroke": null},
    "legend": {"orient": "bottom", "labelFontSize": 12, "titleFontSize": 12}
  }
}
