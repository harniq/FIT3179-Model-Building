
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Straight schematic connections from kit company countries to the Canberra exhibition, not shipping routes.",
  "width": "container",
  "height": 350,
  "autosize": {"type": "fit", "contains": "padding"},
  "background": "transparent",
  "projection": {"type": "equalEarth"},

  "params": [
    {
      "name": "countryFocus", "value": "All countries",
      "bind": {
        "input": "select", "name": "Company country: ",
        "options": ["All countries", "Japan", "United Kingdom", "Czechia", "China", "Germany",
                    "United States", "South Korea", "Italy", "Ukraine", "Poland"]
      }
    }
  ],

  "layer": [
    {
      "data": {"url": "world-map.json", "format": {"type": "topojson", "feature": "countries"}},
      "transform": [{"filter": "datum.id != 10"}],
      "mark": {"type": "geoshape", "fill": "#e5eae3", "stroke": "white", "strokeWidth": 0.7}
    },
    {
      "data": {"url": "data_countries.json"},
      "mark": {"type": "rule", "color": "#23634c"},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "longitude2": {"datum": 149.13},
        "latitude2": {"datum": -35.28},
        "strokeWidth": {
          "field": "entries", "type": "quantitative",
          "scale": {"domain": [0, 180], "range": [0, 10]},
          "legend": {"title": "Matched entries", "values": [15, 50, 150], "orient": "bottom", "direction": "horizontal", "offset": 10},
        "opacity": {
          "condition": {"test": "countryFocus == 'All countries' || datum.country == countryFocus", "value": 0.8},
          "value": 0.035
        },
        "tooltip": [
          {"field": "country", "type": "nominal", "title": "Company country"},
          {"field": "entries", "type": "quantitative", "title": "Matched entries"}
        ]
      }
    },
    {
      "data": {"url": "data_countries.json"},
      "mark": {"type": "circle", "color": "#23634c", "size": 35, "stroke": "white"},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "opacity": {
          "condition": {"test": "countryFocus == 'All countries' || datum.country == countryFocus", "value": 1},
          "value": 0.2
        },
        "tooltip": [
          {"field": "country", "type": "nominal", "title": "Company country"},
          {"field": "entries", "type": "quantitative", "title": "Matched entries"}
        ]
      }
    },
    {
      "data": {"url": "data_countries.json"},
      "transform": [{"filter": "countryFocus != 'All countries' && datum.country == countryFocus"}],
      "mark": {"type": "text", "dy": -12, "fontSize": 12, "fontWeight": "bold", "color": "#20372f"},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "country"}
      }
    },
    {
      "data": {"values": [{"lon": 149.13, "lat": -35.28, "place": "Canberra"}]},
      "mark": {"type": "point", "shape": "diamond", "filled": true, "size": 140,
               "color": "#b65d35", "stroke": "white", "strokeWidth": 1.5},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"}
      }
    },
    {
      "data": {"values": [{"lon": 149.13, "lat": -35.28, "place": "Canberra"}]},
      "mark": {"type": "text", "dy": 23, "fontSize": 13, "fontWeight": "bold", "color": "#20372f"},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "place"}
      }
    }
  ],

  "config": {
    "font": "IBM Plex Sans", "view": {"stroke": null},
    "legend": {"orient": "bottom", "labelFontSize": 12, "titleFontSize": 12}
  }
}
