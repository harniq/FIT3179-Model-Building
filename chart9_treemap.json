{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Treemap of all 817 ScaleACT entries by category, rectangle area represents entry count.",
  "width": 650,
  "height": 330,
  "padding": 0,
  "autosize": {"type": "fit", "contains": "padding"},
  "background": "transparent",
  "data": [
    {
      "name": "tree",
      "url": "data_categories.json",
      "transform": [
        {"type": "stratify", "key": "id", "parentKey": "parent"},
        {
          "type": "treemap",
          "field": "entries",
          "sort": {"field": "value", "order": "descending"},
          "method": "squarify",
          "size": [{"signal": "width"}, {"signal": "height"}],
          "paddingInner": 3,
          "round": false
        }
      ]
    },
    {"name": "leaves", "source": "tree", "transform": [{"type": "filter", "expr": "datum.depth == 1"}]}
  ],
  "marks": [
    {
      "type": "rect",
      "from": {"data": "leaves"},
      "encode": {
        "enter": {"stroke": {"value": "white"}, "strokeWidth": {"value": 1}},
        "update": {
          "x": {"field": "x0"},
          "y": {"field": "y0"},
          "x2": {"field": "x1"},
          "y2": {"field": "y1"},
          "fill": {"signal": "datum.id == 'Aircraft' ? '#23634c' : '#d7e4d6'"},
          "tooltip": {"signal": "{'Category':datum.id,'Entries':datum.entries,'Share of all 817 entries':format(datum.share,'.1%')}"}
        }
      },
      "name": "categoryTiles"
    },
    {
      "type": "text",
      "interactive": false,
      "from": {"data": "leaves"},
      "encode": {
        "update": {
          "x": {"signal": "(datum.x0+datum.x1)/2"},
          "y": {"signal": "(datum.y0+datum.y1)/2 - 9"},
          "align": {"value": "center"},
          "baseline": {"value": "middle"},
          "text": {"signal": "datum.id == 'Open / other' ? 'Open' : datum.id == 'Special themes' ? 'Themes' : datum.id"},
          "limit": {"signal": "max(0,datum.x1-datum.x0-14)"},
          "font": {"value": "IBM Plex Sans"},
          "fontSize": {"value": 11},
          "fontWeight": {"value": 600},
          "fill": {"signal": "datum.id == 'Aircraft' ? 'white' : '#20372f'"}
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "from": {"data": "leaves"},
      "encode": {
        "update": {
          "x": {"signal": "(datum.x0+datum.x1)/2"},
          "y": {"signal": "(datum.y0+datum.y1)/2 + 11"},
          "align": {"value": "center"},
          "baseline": {"value": "middle"},
          "text": {"signal": "datum.x1-datum.x0 < 100 ? datum.entries : datum.entries+' · '+format(datum.share,'.1%')"},
          "limit": {"signal": "max(0,datum.x1-datum.x0-10)"},
          "font": {"value": "IBM Plex Sans"},
          "fontSize": {"value": 11},
          "fill": {"signal": "datum.id == 'Aircraft' ? 'white' : '#20372f'"}
        }
      }
    }
  ]
}
